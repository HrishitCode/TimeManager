# Postgres connection string. Leave empty for local dev → uses embedded PGlite in ./.data/pglite
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# Neon / RDS / local Postgres work the same way.
DATABASE_URL=

# Optional: max connections per server instance (keep small on serverless)
DATABASE_POOL_MAX=5
